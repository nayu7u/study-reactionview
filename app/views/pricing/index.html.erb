<%# herb:slots server %>
<%# herb:state (plan: "team", seats: 5, annual: false, support: false) %>

<section class="hero">
  <div class="hero-badge">Server mode — 金額はサーバーが計算</div>
  <h1>Pricing</h1>
  <p class="hero-sub">プランと席数を選ぶと、見積もりをサーバーが計算し直します。返るのは HTML 全体ではなく、内訳の値だけです。</p>
</section>

<div class="split pricing-layout">
  <section class="feature" data-feature="pricing">
    <span class="feature-tag">機能⑮ サーバー計算の見積もり</span>
    <h2>プランと席数</h2>

    <div class="plan-grid" role="group" aria-label="プラン">
      <button class="plan-card" data-herb-set="plan=starter" aria-pressed="<%= @plan_key == "starter" %>">
        <span class="plan-name"><%= @plans["starter"][:label] %></span>
        <span class="plan-price"><%= number_to_currency(@plans["starter"][:price], unit: "¥", precision: 0) %><small>/席/月</small></span>
        <span class="plan-blurb"><%= @plans["starter"][:blurb] %></span>
      </button>
      <button class="plan-card" data-herb-set="plan=team" aria-pressed="<%= @plan_key == "team" %>">
        <span class="plan-name"><%= @plans["team"][:label] %></span>
        <span class="plan-price"><%= number_to_currency(@plans["team"][:price], unit: "¥", precision: 0) %><small>/席/月</small></span>
        <span class="plan-blurb"><%= @plans["team"][:blurb] %></span>
      </button>
      <button class="plan-card" data-herb-set="plan=business" aria-pressed="<%= @plan_key == "business" %>">
        <span class="plan-name"><%= @plans["business"][:label] %></span>
        <span class="plan-price"><%= number_to_currency(@plans["business"][:price], unit: "¥", precision: 0) %><small>/席/月</small></span>
        <span class="plan-blurb"><%= @plans["business"][:blurb] %></span>
      </button>
    </div>

    <div class="seat-row">
      <span class="field-label">席数</span>
      <div class="qty-group">
        <button data-herb-decrement="seats" data-herb-action="$refresh" aria-label="席数を減らす" disabled="<%= seats <= 1 %>">−</button>
        <span class="qty-value"><%= @seats %></span>
        <button data-herb-increment="seats" data-herb-action="$refresh" aria-label="席数を増やす" disabled="<%= seats >= 50 %>">＋</button>
      </div>
      <span class="toolbar-note">1〜50席</span>
    </div>

    <nav class="seg" aria-label="請求サイクル">
      <button class="seg-btn" data-herb-set="annual=false" data-herb-action="$refresh" aria-pressed="<%= !@annual %>">月払い</button>
      <button class="seg-btn" data-herb-set="annual=true" data-herb-action="$refresh" aria-pressed="<%= @annual %>">年払い</button>
    </nav>

    <div class="toolbar">
      <nav class="seg" aria-label="優先サポート">
        <button class="seg-btn" data-herb-set="support=false" data-herb-action="$refresh" aria-pressed="<%= !@support %>">サポートなし</button>
        <button class="seg-btn" data-herb-set="support=true" data-herb-action="$refresh" aria-pressed="<%= @support %>">優先サポート +¥10,000/月</button>
      </nav>
    </div>

    <p class="task-note">
      席数の増減は分岐が反転しないため、<code>$refresh</code> を合成しています。
      表示の切替は <code>data-active</code> / <code>hidden</code> で行い、金額は分岐の外の READ slot で受けます。
    </p>
  </section>

  <aside class="feature pricing-summary" data-feature="pricing-summary">
    <span class="feature-tag">見積もり</span>
    <h2>お見積もり</h2>
    <p class="price-total" aria-live="polite" data-herb-name="total"><%= number_to_currency(@total, unit: "¥", precision: 0) %></p>

    <dl class="price-lines">
      <div><dt>基本料金（<%= @plan[:label] %> × <%= @seats %>席）</dt><dd data-herb-name="base_fee"><%= number_to_currency(@seat_fee, unit: "¥", precision: 0) %></dd></div>
      <div class="price-line-discount" hidden="<%= seats < 10 %>">
        <dt>ボリューム割引（10%）</dt>
        <dd>-<span data-herb-name="volume_discount"><%= number_to_currency(@volume_discount, unit: "¥", precision: 0) %></span></dd>
      </div>
      <div class="price-line-note" hidden="<%= seats >= 10 %>">
        <dt>ボリューム割引</dt>
        <dd>10席以上で10%OFF</dd>
      </div>
      <div class="price-line-support" data-active="<%= support %>">
        <dt>優先サポート</dt>
        <dd data-herb-name="support_fee"><%= number_to_currency(@support_fee, unit: "¥", precision: 0) %></dd>
      </div>
      <div><dt><%= @annual ? "小計（12か月・年払い割引）" : "小計" %></dt><dd data-herb-name="subtotal"><%= number_to_currency(@subtotal, unit: "¥", precision: 0) %></dd></div>
      <div class="price-line-discount price-line-annual" data-active="<%= annual %>">
        <dt>年払い割引（15%）</dt>
        <dd>-<span data-herb-name="annual_discount"><%= number_to_currency(@annual_discount, unit: "¥", precision: 0) %></span></dd>
      </div>
      <div><dt>税抜合計</dt><dd data-herb-name="discounted"><%= number_to_currency(@discounted, unit: "¥", precision: 0) %></dd></div>
      <div><dt>消費税（10%）</dt><dd data-herb-name="tax"><%= number_to_currency(@tax, unit: "¥", precision: 0) %></dd></div>
    </dl>

    <p class="toolbar-note">現在 <%= @seats %> 席で見積もり中。</p>
    <p class="toolbar-note">優先サポートは任意です。</p>

    <p class="task-note">金額はすべてサーバーで計算しています。内訳は READ slot なので、同じ <code>?format=slots</code> 応答で値だけが差し替わります。表示の切替は state の表示属性（年払い・サポートは <code>data-active</code>、ボリュームは <code>hidden</code> の presence）で行い、金額は分岐の外に置いています。JavaScript を切ると初期表示のみで、再計算はできません。</p>
  </aside>
</div>

<p class="toolbar-note plan-description"><%= "#{@plan[:label]}: #{@plan[:blurb]}" %></p>

<div hidden aria-hidden="true">
  <% if plan == "starter" %>Starter<% elsif plan == "team" %>Team<% else %>Business: 統制と安心のプランです。<% end %>
  <% if annual == true || annual == false %>年払い割引<% end %>
  <% if seats > 0 %>席数あり<% end %>
  <% if support == true || support == false %>優先サポート<% end %>
</div>

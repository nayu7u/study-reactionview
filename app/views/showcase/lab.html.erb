<%# herb:slots client %>
<%# herb:state (tab: "all", unread: 3, palette_open: false, preview: false, mute: false, draft: "", ready: draft != "", step: 1, name: "", email: "", name_ok: name != "", email_ok: email != "", bio: "", ready_bio: bio != "" && bio.length <= 60, over: bio.length > 60, in_cart: 0) %>

<section class="hero">
  <div class="hero-badge">Client mode — サーバー往復ゼロ</div>
  <h1>Client Lab</h1>
  <p class="hero-sub">このページの未描画ブランチは <code>&lt;template data-herb-region&gt;</code> に格納済み。開閉・切替・カウントはすべてブラウザ内で完結します。<code>$refresh</code> だけが意図的な脱出口です。</p>
</section>

<div class="feature-grid">

  <section class="feature" data-feature="tabs">
    <span class="feature-tag">機能④ client mode 分岐とセグメント切替</span>
    <h2>通知タブ</h2>
    <nav class="seg" aria-label="通知の表示切り替え">
      <button class="seg-btn" data-herb-set="tab=all" aria-pressed="<%= tab == "all" %>"><span class="seg-dot"></span>すべて</button>
      <button class="seg-btn" data-herb-set="tab=mentions" aria-pressed="<%= tab == "mentions" %>"><span class="seg-dot"></span>メンション</button>
    </nav>
    <p class="toolbar-note" aria-live="polite"><% case tab %><% when "mentions" %>メンションだけ表示中<% else %>全通知を表示中<% end %></p>
<% if tab == "all" %>
      <ul class="task-list">
        <% @notifications.each do |n| %>
          <%# herb:key n[:id] %>
          <li class="task-item">
            <span class="task-title"><%= n[:title] %></span>
            <span class="task-status"><%= n[:detail] %></span>
          </li>
        <% end %>
      </ul>
    <% else %>
      <ul class="task-list">
        <% @notifications.select { |n| n[:kind] == "mention" }.each do |n| %>
          <%# herb:key n[:id] %>
          <li class="task-item">
            <span class="task-title"><%= n[:title] %></span>
            <span class="task-status"><%= n[:detail] %></span>
          </li>
        <% end %>
      </ul>
    <% end %>
  </section>

  <section class="feature" data-feature="counter">
    <span class="feature-tag">機能⑤ カウンタ（increment / decrement / reset）</span>
    <div class="feature-head">
      <h2>未読バッジ</h2>
      <span class="badge" aria-live="polite"><%= unread %></span>
    </div>
    <p>数字はブラウザ所有の Integer 状態。<code>data-herb-by</code> で一度に加減できます。</p>
    <div class="toolbar">
      <button data-herb-increment="unread" data-herb-by="2">+2</button>
      <button data-herb-decrement="unread">-1</button>
      <button data-herb-reset="unread">リセット</button>
      <button data-herb-reset>全部戻す</button>
    </div>
  </section>

  <section class="feature" data-feature="palette">
    <span class="feature-tag">機能⑥ palette型モーダル（window句 / Esc / outside）</span>
    <div class="feature-head">
      <h2>コマンドパレット</h2>
      <button data-herb-set="click->palette_open=true keydown.meta+k@window->palette_open=true keydown.ctrl+k@window->palette_open=true"><kbd>⌘K</kbd> で開く</button>
    </div>
    <p><kbd>Esc</kbd> と外側クリックで閉じます。入力はpresence束縛：文字数と「検索中」表示が即時追随します。</p>
    <div data-herb-set="mouseenter->preview=true mouseleave->preview=false" class="lib-hover">
      👀 ここにホバー
    </div>
    <% if preview %><p class="pill">プレビュー表示中</p><% end %>
  </section>

  <section class="feature" data-feature="switch">
    <span class="feature-tag">機能⑦ switch束縛と派生状態（ready: draft != ""）</span>
    <h2>オンオフとライブ入力</h2>
    <div class="switch-row">
      <label class="task-check">
        <input type="checkbox" class="switch" checked="<%= mute %>" aria-label="通知をミュート">
        <span><% if mute %>🔕 通知オフ<% else %>🔔 通知オン<% end %></span>
      </label>
    </div>
    <textarea class="field" aria-label="下書き入力" placeholder="下書きを入力…"><%= draft %></textarea>
    <p class="char-hint" aria-live="polite"><%= draft.length %> 文字 <% if ready %>・送信準備OK<% end %></p>
    <div class="toolbar">
      <button disabled="<%= !ready %>">送信（実装は省略）</button>
      <button data-herb-reset="draft">クリア</button>
      <button class="btn btn-ghost" data-herb-action="$refresh">🔄 同期（サーバーから再描画）</button>
    </div>
  </section>

  <section class="feature" data-feature="wizard">
    <span class="feature-tag">機能⑪ 多段ウィザード（step状態と派生ゲート、腕ごとの入力）</span>
    <h2>サインアップステッパー</h2>
    <div class="dot-row" aria-label="ステップ">
      <span class="dot" aria-current="<%= step == 1 %>"></span>
      <span class="dot" aria-current="<%= step == 2 %>"></span>
      <span class="dot" aria-current="<%= step == 3 %>"></span>
      <span class="toolbar-note">ステップ <%= step %>/3</span>
    </div>
    <% if step == 1 %>
      <div class="wizard-step">
        <label class="field-label" for="wiz_name">名前</label>
        <input class="field" id="wiz_name" value="<%= name %>" placeholder="お名前" autocomplete="off">
      </div>
      <div class="toolbar">
        <button class="btn btn-primary" data-herb-increment="step" disabled="<%= !name_ok %>">次へ</button>
      </div>
    <% end %>
    <% if step == 2 %>
      <div class="wizard-step">
        <label class="field-label" for="wiz_email">メール</label>
        <input class="field" id="wiz_email" value="<%= email %>" placeholder="you@example.com" autocomplete="off">
      </div>
      <div class="toolbar">
        <button data-herb-decrement="step">戻る</button>
        <button class="btn btn-primary" data-herb-increment="step" disabled="<%= !email_ok %>">次へ</button>
      </div>
    <% end %>
    <% if step == 3 %>
      <div class="wizard-step">
        <p class="toolbar-note"><strong><%= name %></strong>（<%= email %>）で登録します。よろしいですか？</p>
      </div>
      <div class="toolbar">
        <button data-herb-decrement="step">戻る</button>
        <button class="btn btn-primary" data-herb-reset="step name email">完了（リセット）</button>
      </div>
    <% end %>
    <p class="task-note">ゲートは派生状態（<code>name_ok: name != ""</code>）→ presence束縛の disabled。未描画の腕は全部 <code>&lt;template&gt;</code> に停めてあるので、切替は往復ゼロです。</p>
  </section>

  <section class="feature" data-feature="validate">
    <span class="feature-tag">機能⑫ 入力バリデーション（length変換＋順序比較＋派生ゲート）</span>
    <h2>文字数オーバー検知</h2>
    <textarea class="field" aria-label="自己紹介" placeholder="60字以内で自己紹介…"><%= bio %></textarea>
    <p class="char-hint" aria-live="polite"><%= bio.length %>/60字 <% if over %><span class="over-pill">⚠ 長すぎます</span><% end %></p>
    <div class="toolbar">
      <button class="btn btn-primary" disabled="<%= !ready_bio %>">保存（実装は省略）</button>
      <button data-herb-reset="bio">クリア</button>
    </div>
    <p class="task-note">上限は派生状態の宣言に書く: <code>over: bio.length &gt; 60</code>。送信ゲートは <code>ready_bio: bio != "" &amp;&amp; bio.length &lt;= 60</code> のコンボ派生 — 比較はクライアント評価なので往復ゼロ。</p>
  </section>

  <section class="feature" data-feature="qty">
    <span class="feature-tag">機能⑬ 数量ステッパー（行ごとの数量状態＋計数fold）</span>
    <div class="feature-head">
      <h2>カート行</h2>
    </div>
    <ul class="task-list" data-herb-name="cart">
      <% @cart_items.each do |item| %>
        <%# herb:key item[:id] %>
        <%# herb:state (qty: 0) %>
        <li class="qty-row">
          <span class="qty-name"><%= item[:name] %><br><span class="qty-price">¥<%= item[:price] %></span></span>
          <% if qty > 0 %><% in_cart += 1 %><% end %>
          <span class="qty-group">
            <button data-herb-decrement="qty" disabled="<%= qty == 0 %>" aria-label="<%= item[:name] %>を減らす">−</button>
            <span class="qty-value"><%= qty %></span>
            <button data-herb-increment="qty" aria-label="<%= item[:name] %>を増やす">＋</button>
          </span>
        </li>
      <% end %>
    </ul>
    <p class="task-stat" aria-live="polite"><span class="badge"><%= in_cart %></span> 点をカートに</p>
    <p class="task-note">数量は行ごとのブラウザ状態。<code>in_cart</code> は計数fold（条件付き <code>+= 1</code>）で即時追従 — counted state をループの前で読むと「count is complete 前」のコンパイルエラーになるので統計はリストの後に置く。金額合計は増分が定数でないため fold に載らない。0で減ボタンを無効化する<code>disabled</code>は順序比較のpresence束縛。</p>
  </section>

  <section class="feature" data-feature="accordion">
    <span class="feature-tag">機能⑭ アコーディオン（行ごとのopen状態と停まった答えの腕）</span>
    <h2>FAQ</h2>
    <ul class="task-list" data-herb-name="faqs">
      <% @faqs.each do |faq| %>
        <%# herb:key faq[:id] %>
        <%# herb:state (open: false) %>
        <li>
          <button class="acc-head" data-herb-toggle="open">
            <span class="task-title"><%= faq[:q] %></span>
            <span class="acc-marker"><% if open %>－<% else %>＋<% end %></span>
          </button>
          <div class="acc-body" hidden="<%= !open %>"><%= faq[:a] %></div>
        </li>
      <% end %>
    </ul>
    <p class="task-note">答えのテキストは腕に置かず、<code>hidden</code> 属性のpresence束縛（<code>!open</code>）で切替 — 行ごとの分岐の腕は materialize できても、腕に置いたサーバー読みの値は空で届く（0.6.0実測）。マーカーの＋/－は静的テキストなので腕で差し替わります。</p>
  </section>

</div>

<% if palette_open %>
  <div class="drawer-backdrop">
    <div class="modal" role="dialog" aria-modal="true" aria-label="コマンドパレット" data-herb-set="click@outside->palette_open=false keydown.esc@window->palette_open=false">
      <input class="field" value="<%= draft %>" placeholder="コマンドを検索…" autocomplete="off" aria-label="コマンド検索">
      <p class="char-hint"><%= draft.length %> 文字 — ⌘K / Esc / outside のすべてがクライアント処理です</p>
      <div class="modal-actions">
        <button class="btn btn-ghost" data-herb-reset="palette_open draft">閉じてクリア</button>
      </div>
    </div>
  </div>
<% end %>

<footer class="page-meta">
  Client mode は Response に <code>&lt;template data-herb-region&gt;</code> を含みます。DevToolsで確認できます。
</footer>

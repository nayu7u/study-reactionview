<%# herb:slots client %>

<section class="hero">
  <div class="hero-badge">Client mode — 深さ2+の per-node state</div>
  <h1>Tree</h1>
  <p class="hero-sub">フォルダの開閉は 0 往復。深さ2以上の入れ子で、ノードごとの state が独立するかを見ます。</p>
</section>

<section class="tree-page">
  <div class="tree-toolbar">
    <p>
      <%= @node_count %> nodes / <%= @folder_count %> folders ・
      最終取得 <span data-herb-name="loaded_at"><%= @loaded_at.strftime("%H:%M:%S") %></span>
    </p>
    <button class="btn btn-ghost" data-herb-action="$refresh">最新を取得</button>
  </div>

  <ul class="tree-root">
    <% @roots.each do |root| %>
      <%# herb:key root.id %>
      <%# herb:state (open_root: true) %>
      <li class="tree-node tree-<%= root.kind %>">
        <% if root.kind == "folder" %>
          <button class="tree-toggle" data-herb-toggle="open_root" aria-expanded="<%= open_root %>">
            <span class="tree-chevron" aria-hidden="true"></span>
            <span class="tree-icon" aria-hidden="true">📁</span>
            <span class="tree-name"><%= root.name %></span>
          </button>
        <% else %>
          <%= render "file", node: root %>
        <% end %>

        <ul class="tree-children" hidden="<%= !open_root %>">
          <%= render "level2",
            nodes: @children_by_parent[root.id] || [],
            children_by_parent: @children_by_parent %>
        </ul>
      </li>
    <% end %>
  </ul>

  <p class="task-note">
    子のコレクションを分岐で包まないので、slots 応答は items/order のまま。
    <code>open_root</code> / <code>open_l2</code> / <code>open_l3</code> を各レベルのループで宣言しています。
  </p>
</section>

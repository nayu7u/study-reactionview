<%# herb:slots server %>
<%# herb:state (drawer_open: false, query: "", order: "oldest", title: "", done_count: 0, pinned_count: 0) %>

<section class="hero">
  <div class="hero-badge"><%= Task.count %> tasks on the sprint board</div>
  <h1>Sprint Hub</h1>
  <p class="hero-sub">ReActionView 0.6.0 — この画面のすべては <code>.html.erb</code> です。Reactもなし、ビルドもなし。</p>
</section>

<div class="feature-grid">

  <section class="feature" data-feature="server-reads">
    <span class="feature-tag">機能① サーバーが答える読み取り（herb_state / debounce / $refresh）</span>
    <h2>Sprintの検索と並び替え</h2>
    <p>検索とソートはDBを引くので、ブラウザが状態を送り、同じアクションが答えます。</p>
    <div class="toolbar">
      <input class="field" name="search" value="<%= query %>" data-herb-set="query=$value" data-herb-debounce="220" aria-label="タスクを検索" placeholder="タスクを検索…" autocomplete="off">
      <button class="btn btn-ghost" data-herb-reset="query">クリア</button>
      <select class="select" data-herb-set="order=$value" aria-label="並び替え">
        <option value="oldest" selected="<%= order == "oldest" %>">古い順</option>
        <option value="newest" selected="<%= order == "newest" %>">新しい順</option>
      </select>
      <button class="btn btn-ghost" data-herb-action="$refresh">🔄 同期</button>
    </div>
    <p class="toolbar-note"><% if query.empty? %>全件表示<% else %>「<%= query %>」の結果（サーバーで絞り込み済み）<% end %></p>
  </section>

  <section class="feature" data-feature="fine-grained">
    <span class="feature-tag">機能② 細粒度更新＋楽観的追加（key / data-herb-into / カウントfold）</span>
    <div class="feature-head">
      <h2>タスク一覧</h2>
      <button class="btn btn-primary" data-herb-toggle="drawer_open">＋ 新規タスク</button>
    </div>
    <ul class="task-list" data-herb-name="tasks">
      <% @tasks.each do |task| %>
        <%# herb:key task.id %>
        <%# herb:state (done: false, pinned: false) %>
        <li class="task-item">
          <% if done %><% done_count += 1 %><% end %>
          <% if pinned %><% pinned_count += 1 %><% end %>
          <label class="task-check">
            <input type="checkbox" checked="<%= done %>">
            <span class="task-title" data-herb-name="title"><%= task.title %></span>
          </label>
          <span class="task-status"><span class="pill-done">✔ 完了</span><span class="pill-open">未完了</span></span>
          <label class="task-pin">
            <input type="checkbox" aria-label="<%= task.title %> をピン留め" checked="<%= pinned %>">
            <span class="pin-glyph" aria-hidden="true">★</span>
          </label>
        </li>
      <% end %>
    </ul>
    <p class="task-stat" aria-live="polite"><%= done_count %>/<%= Task.count %> 件完了 ・ <span class="pin-stat"><%= pinned_count %> 件ピン留め</span></p>
    <p class="task-note">取り消し線は presence バインディング＋CSS で即時。<code>done_count</code> fold が統計を即時に動かし、行の文言は同じ往復の答えで追随します。</p>
  </section>

  <section class="feature" data-feature="drawer">
    <span class="feature-tag">機能③ ドロワーとフォームのバインディング（presence バインディング / 派生は無しでもdisabledで担保） </span>
    <h2>作成ドロワーの動き</h2>
    <p>「＋ 新規タスク」でスライドイン。<kbd>⌘B</kbd>/<kbd>Ctrl+B</kbd> でも開けます。backdropクリック・<kbd>Esc</kbd>で閉じる。送信成功で閉じ、打ち込んだtitleもリセットされます。</p>
    <div class="drawer-demo-hint" data-herb-set="keydown.meta+b@window->drawer_open=true keydown.ctrl+b@window->drawer_open=true">💡 <kbd>⌘B</kbd> / <kbd>Ctrl+B</kbd> でも開けます</div>
  </section>

</div>

<% if drawer_open %>
  <div class="drawer-backdrop">
    <aside class="drawer" role="dialog" aria-modal="true" aria-label="新規タスク作成" data-herb-set="click@outside->drawer_open=false keydown.esc@window->drawer_open=false">
      <div class="drawer-head">
        <h2>新規タスク</h2>
        <button class="btn btn-ghost" data-herb-reset="drawer_open" aria-label="閉じる">✕</button>
      </div>
      <form action="<%= tasks_path %>" method="post" data-herb-into="tasks"
        data-herb-set="submit->drawer_open=false"
        data-herb-reset="submit->title">
        <input type="hidden" name="authenticity_token" value="<%= form_authenticity_token %>">
        <label class="field-label" for="task_title">タイトル</label>
        <input class="field" id="task_title" name="task[title]" autocomplete="off" placeholder="何をやる？" value="<%= title %>" data-herb-debounce="180">
        <p class="char-hint"><%= title.length %> 文字</p>
        <div class="drawer-actions">
          <button type="button" class="btn btn-ghost" data-herb-reset="title">クリア</button>
          <button class="btn btn-primary" disabled="<%= title.blank? %>">追加</button>
        </div>
      </form>
      <p class="drawer-note">送信はオプティミスティック: 追加ボタンを押すと、サーバーの応答を待たずに行が入ります。</p>
    </aside>
  </div>
<% end %>

<footer class="page-meta">
  Dev環境では右上にHerbバッジが出ます。意図的にタグを壊すと、ファイル名・行番号付きのオーバーレイが出ます。
</footer>

<%# UI Accordion — per-item boolean states + hidden presence binding.
    The answer stays OUTSIDE the branch arm on purpose and so does the
    marker: both the ＋/－ spans and the body flip through presence bindings,
    because arms inside a partial are never materialized in 0.6.0 (client
    mode doesn't park them, refetch answers branch:null).
    locals: items: (array of {id:, q:, a:}) %>
<ul class="ui-accordion" data-herb-name="accordion">
  <% items.each do |item| %>
    <%# herb:key item[:id] %>
    <%# herb:state (open: false) %>
    <li class="ui-acc-item">
      <button class="ui-acc-head" data-herb-toggle="open">
        <span class="ui-acc-q"><%= item[:q] %></span>
        <span class="ui-acc-marker"><span hidden="<%= open %>">＋</span><span hidden="<%= !open %>">－</span></span>
      </button>
      <div class="ui-acc-body" hidden="<%= !open %>"><%= item[:a] %></div>
    </li>
  <% end %>
</ul>

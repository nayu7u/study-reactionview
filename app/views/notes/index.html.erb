<%# herb:slots client %>
<%# herb:state (tab: "inbox", unread: 3, composing: false, palette: false, preview: false, draft: "", done_count: 0, busy: composing) %>

<h1>Notes (client mode)</h1>

<p><% if tab == "inbox" %>Your inbox<% else %>Your archive<% end %></p>

<nav>
  <button data-herb-set="tab=inbox">Inbox (<%= unread %>)</button>
  <button data-herb-set="tab=archive">Archive</button>
  <button data-herb-increment="unread" data-herb-by="2">Simulate +2 unreads</button>
  <button data-herb-decrement="unread">Mark one read</button>
  <button data-herb-reset>Start over</button>
  <button data-herb-set="keydown.meta+k@window->palette=true">Search ⌘K</button>
  <button data-herb-action="$refresh">Reload server parts</button>
</nav>

<div data-herb-set="mouseenter->preview=true mouseleave->preview=false">Hover me</div>
<% if preview %><p>Preview follows the cursor</p><% end %>

<% if palette %>
  <input value="" placeholder="Palette…" data-herb-reset="keydown.esc->palette">
<% end %>

<p><% if tab == "inbox" %>Inbox notes came from the server at load, or after $refresh or a server ask.<% else %>The list below still holds the server-rendered pane until the server answers.<% end %></p>

<ul>
  <% @notes.each do |note| %>
    <%# herb:key note[:id] %>
    <%# herb:state (done: false) %>
    <li><input type="checkbox" checked="<%= done %>"> <%= note[:title] %></li>
  <% end %>
</ul>

<p><%= done_count %> done</p>

<button data-herb-toggle="composing">New note</button>

<% if composing %>
  <textarea data-herb-reset="keydown.esc->draft"><%= draft %></textarea>
  <p><%= draft.length %> characters</p>
  <p><% if busy %>Working<% else %>Ready<% end %></p>
  <button disabled="<%= draft.blank? %>">Save</button>
  <button data-herb-reset="draft">Clear</button>
<% end %>

<p>This page parks its unrendered branches in the page itself (client mode), so tabs, counters, palette and composer never ask the server. $refresh is the deliberate exception.</p>

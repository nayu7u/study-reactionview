<%# herb:slots client %>
<%# herb:state (focus: "all") %>

<section class="hero">
  <div class="hero-badge">Client mode — 遅延を測る</div>
  <h1>Dashboard</h1>
  <p class="hero-sub">ページの外枠はすぐ返し、重い集計だけを後から届けます。</p>
  <%= link_to slow_demo? ? "遅延デモ: ON（900ms）" : "遅延デモ: OFF",
        dashboard_path(slow: slow_demo? ? nil : 1), class: "slow-toggle" %>
</section>

<noscript><p class="task-note">遅延ブロックの読み込みには JavaScript が必要です。</p></noscript>

<div class="dashboard-layout">
  <section class="dashboard-card dashboard-summary">
    <span class="feature-tag">機能⑱ Async サマリー</span>
    <Async delay="150" hold="400">
      <% summary = dashboard_summary %>
      <div class="metric-row">
        <div class="metric">
          <span class="metric-value"><%= summary[:total] %></span>
          <span class="metric-label">全タスク</span>
        </div>
        <div class="metric">
          <span class="metric-value"><%= summary[:high] %></span>
          <span class="metric-label">優先度: 高</span>
        </div>
        <div class="metric">
          <span class="metric-value"><%= summary[:recent] %></span>
          <span class="metric-label">直近24時間</span>
        </div>
      </div>
      <Fallback>
        <div class="skeleton" aria-hidden="true">…</div>
      </Fallback>
    </Async>
  </section>

  <div class="dashboard-main">
    <section class="dashboard-card dashboard-focus">
      <span class="feature-tag">機能⑳ Fragment の優先度フォーカス</span>
      <h2>優先度フォーカス</h2>
      <div class="seg" role="group" aria-label="優先度フォーカス">
        <button class="seg-btn" data-herb-set="focus=all" aria-pressed="<%= focus == "all" %>">すべて</button>
        <button class="seg-btn" data-herb-set="focus=high" aria-pressed="<%= focus == "high" %>">高</button>
        <button class="seg-btn" data-herb-set="focus=medium" aria-pressed="<%= focus == "medium" %>">中</button>
        <button class="seg-btn" data-herb-set="focus=low" aria-pressed="<%= focus == "low" %>">低</button>
      </div>

      <Fragment delay="120" hold="500" on="focus">
        <%= render "dashboard/focus_stats", focus: focus %>
        <Fallback>
          <p class="skeleton-note">集計中…</p>
        </Fallback>
      </Fragment>
    </section>

    <section class="dashboard-card dashboard-activity">
      <span class="feature-tag">機能⑲ Lazy の defer</span>
      <h2>最近のアクティビティ</h2>
      <Lazy delay="150" hold="400">
        <% activity = recent_activity.limit(3).to_a %>
        <% if activity[0] %>
          <div class="activity-row">
            <span class="activity-title"><%= activity[0].title %></span>
            <span class="prio prio-<%= activity[0].priority %>"><%= dashboard_priority_label(activity[0].priority) %></span>
            <span class="activity-time"><%= dashboard_time_ago(activity[0].created_at) %></span>
          </div>
        <% end %>
        <% if activity[1] %>
          <div class="activity-row">
            <span class="activity-title"><%= activity[1].title %></span>
            <span class="prio prio-<%= activity[1].priority %>"><%= dashboard_priority_label(activity[1].priority) %></span>
            <span class="activity-time"><%= dashboard_time_ago(activity[1].created_at) %></span>
          </div>
        <% end %>
        <% if activity[2] %>
          <div class="activity-row">
            <span class="activity-title"><%= activity[2].title %></span>
            <span class="prio prio-<%= activity[2].priority %>"><%= dashboard_priority_label(activity[2].priority) %></span>
            <span class="activity-time"><%= dashboard_time_ago(activity[2].created_at) %></span>
          </div>
        <% end %>
        <Fallback>
          <p class="skeleton-note">読み込み中…</p>
          <% fallback_activity = recent_activity.limit(3).to_a %>
          <% if fallback_activity[0] %>
            <div class="activity-row">
              <span class="activity-title"><%= fallback_activity[0].title %></span>
              <span class="prio prio-<%= fallback_activity[0].priority %>"><%= dashboard_priority_label(fallback_activity[0].priority) %></span>
              <span class="activity-time"><%= dashboard_time_ago(fallback_activity[0].created_at) %></span>
            </div>
          <% end %>
          <% if fallback_activity[1] %>
            <div class="activity-row">
              <span class="activity-title"><%= fallback_activity[1].title %></span>
              <span class="prio prio-<%= fallback_activity[1].priority %>"><%= dashboard_priority_label(fallback_activity[1].priority) %></span>
              <span class="activity-time"><%= dashboard_time_ago(fallback_activity[1].created_at) %></span>
            </div>
          <% end %>
          <% if fallback_activity[2] %>
            <div class="activity-row">
              <span class="activity-title"><%= fallback_activity[2].title %></span>
              <span class="prio prio-<%= fallback_activity[2].priority %>"><%= dashboard_priority_label(fallback_activity[2].priority) %></span>
              <span class="activity-time"><%= dashboard_time_ago(fallback_activity[2].created_at) %></span>
            </div>
          <% end %>
        </Fallback>
      </Lazy>
    </section>  </div>

  <aside class="dashboard-side">
    <section class="dashboard-card dashboard-heartbeat">
      <span class="feature-tag">機能㉑ poll ハートビート</span>
      <h2>ハートビート</h2>
      <Async poll="3000" delay="150" hold="400">
        <% beat = heartbeat %>
        <div class="heartbeat" data-heartbeat-at="<%= beat[:at].iso8601 %>">
          <p class="heartbeat-label">最終同期</p>
          <p class="heartbeat-time"><%= beat[:at].strftime("%H:%M:%S") %></p>
          <p class="heartbeat-queue">デモキュー: <span data-heartbeat-queue><%= beat[:queue] %></span></p>
        </div>
        <Fallback>
          <p class="skeleton-note">同期中…</p>
        </Fallback>
      </Async>
    </section>

    <section class="dashboard-card dashboard-notes">
      <h2>リクエストの数え方</h2>
      <ul class="dashboard-note-list">
        <li>初回: document 1 + Async 2 + Lazy 1</li>
        <li>Lazy: 初期表示で1（内容が届く）</li>
        <li>下段の Lazy はスクロール要求なし（0.6.0）</li>
        <li>フォーカス変更: Fragment 1（Fallback は未観測）</li>
        <li>poll: 3秒ごとに 1</li>
      </ul>
    </section>
  </aside>
</div>


